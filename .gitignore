# ── Large data files ──────────────────────────────────────────────────────
data/gqa_raw/
data/gqa_images_subset/
data/coco_images_val2014/
data/vqav2/
data/**/*.zip
data/**/*.tar
data/**/*.tar.gz

# Keep processed samples and detected SST cache
!data/processed/
!data/vqav2/detected_ssts.json

# ── Model weights and caches ──────────────────────────────────────────────
*.pt
*.pth
*.onnx
*.bin
*.safetensors
runs/
.cache/

# ── Notebook checkpoints and outputs ─────────────────────────────────────
# Keep result CSVs and figures — they are small and useful for readers
# Exclude raw checkpoint files (large, regenerable)
outputs/results/*_checkpoint.csv
outputs/results/*_llava_results.csv
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
pip-wheel-metadata/

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
.venv-1/
venv/
env/
ENV/

# ── OS files ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── LaTeX build artifacts ─────────────────────────────────────────────────
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
